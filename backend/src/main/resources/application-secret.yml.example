# 로컬에서 실제 PostgreSQL을 쓰고 싶을 때만 사용한다.
# 이 파일을 복사해서 application-secret.yml로 저장할 것 (그 파일은 .gitignore로 제외됨)
# cp application-secret.yml.example application-secret.yml
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/winningpick
    driver-class-name: org.postgresql.Driver
    username: CHANGE_ME
    password: CHANGE_ME
  jpa:
    hibernate:
      ddl-auto: update

jwt:
  secret: CHANGE_ME

