APP_NAME=WinningPick AI Service

# PostgreSQL (PGPASSWORD만 필수, 나머지는 기본값 있음)
PGHOST=localhost
PGPORT=5432
PGDATABASE=winningpick
PGUSER=postgres
PGPASSWORD=

# 필수
OPENWEATHER_API_KEY=
ANTHROPIC_API_KEY=

# 로그인 사용자 확인용 (backend application-secret.yml의 jwt.secret과 같은 값)
# 비워 두면 새 AI 분석 생성이 모두 막히고, 이미 저장된 분석만 조회됩니다.
JWT_SECRET=

# CORS (쉼표로 구분, 기본값 http://localhost:5173)
CORS_ALLOW_ORIGINS=http://localhost:5173