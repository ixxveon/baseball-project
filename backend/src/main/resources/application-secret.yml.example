# 로컬에서 실제 PostgreSQL을 쓰고 싶을 때만 사용한다.
# 이 파일을 복사해서 application-secret.yml로 저장할 것 (그 파일은 .gitignore로 제외됨)
# cp application-secret.yml.example application-secret.yml
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/winningpick
    driver-class-name: org.postgresql.Driver
    username: CHANGE_ME
    password: CHANGE_ME
  jpa:
    hibernate:
      ddl-auto: update
  # 인증번호 메일 발송 (Gmail SMTP). 비워두면 인증번호를 서버 로그로만 출력한다.
  # password에는 Gmail 계정 비밀번호가 아니라 2단계 인증 후 발급한 앱 비밀번호(16자리)를 넣는다.
  mail:
    host: smtp.gmail.com
    port: 587
    username: CHANGE_ME
    password: CHANGE_ME
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: CHANGE_ME
            client-secret: CHANGE_ME
          kakao:
            client-id: CHANGE_ME
            client-secret: CHANGE_ME
          naver:
            client-id: CHANGE_ME
            client-secret: CHANGE_ME

jwt:
  secret: CHANGE_ME

